# Alle Hosts liefern dieselbe Anwendung aus. Der Host bleibt erhalten, damit
# Mandant, Branding und öffentliche Links nicht auf eine fremde Marke zeigen.
# Das Zertifikat enthält alle drei Namen als SAN.

<VirtualHost *:80>
    ServerName pruef.koenigsblau.de
    ServerAlias pruef.bsw-consult.gmbh pruef.ceneos.net
    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</VirtualHost>

<VirtualHost *:443>
    ServerName pruef.koenigsblau.de
    ServerAlias pruef.bsw-consult.gmbh pruef.ceneos.net

    DocumentRoot /var/www/html/pruefapp
    DirectoryIndex index.php
    <Directory /var/www/html/pruefapp>
        AllowOverride All
        Require all granted
    </Directory>

    # Die App läuft auf der Domain-Wurzel.
    SetEnv APP_BASE_PATH /

    # Zertifikate aus acme.sh --install-cert.
    SSLEngine on
    SSLCertificateFile    /etc/ssl/private/pruef.koenigsblau.de-fullchain.pem
    SSLCertificateKeyFile /etc/ssl/private/pruef.koenigsblau.de-key.pem
</VirtualHost>

# In der externen Prüfapp-Konfiguration (config/pruefapp.php) ergänzen:
# 'APP_BASE_PATH' => '/',
# 'APP_PUBLIC_BASE_URLS' => [
#     'koenigsblau' => 'https://pruef.koenigsblau.de',
#     'bsw'         => 'https://pruef.bsw-consult.gmbh',
#     'ceneos'      => 'https://pruef.ceneos.net',
# ],
# Damit verwenden auch Cron/PDFs je Mandant die passende Marken-Domain.
