# Öffentliche Adresse der Prüfapp. Zertifikatspfade und die vorhandene
# HTTPS-Konfiguration bitte an den Server anpassen.
#
# Die Aliasse leiten bewusst auf die kanonische Adresse um, damit QR-Codes,
# PDF-Links und OIDC-Callbacks stets dieselbe, vertrauenswürdige URL tragen.

<VirtualHost *:80>
    ServerName prüf.koenigsblau.de
    ServerAlias prüf.bsw-consult.gmbh prüf.saniers.net
    Redirect permanent / https://prüf.koenigsblau.de/
</VirtualHost>

<VirtualHost *:443>
    ServerName prüf.bsw-consult.gmbh
    ServerAlias prüf.saniers.net
    RewriteEngine On
    RewriteRule ^ https://prüf.koenigsblau.de%{REQUEST_URI} [R=301,L]

    # Das Zertifikat muss beide Aliasnamen als SAN enthalten.
    # SSLEngine on
    # SSLCertificateFile /etc/letsencrypt/live/pruef.koenigsblau.de/fullchain.pem
    # SSLCertificateKeyFile /etc/letsencrypt/live/pruef.koenigsblau.de/privkey.pem
</VirtualHost>

<VirtualHost *:443>
    ServerName prüf.koenigsblau.de

    DocumentRoot /var/www/html/pruefapp
    DirectoryIndex index.php
    <Directory /var/www/html/pruefapp>
        AllowOverride All
        Require all granted
    </Directory>

    # Wichtig für PDF-/Cron-Links. APP_BASE_PATH=/ setzt die App an die
    # Domain-Wurzel; bei einem Unterpfad hier z. B. /pruefapp eintragen.
    SetEnv APP_PUBLIC_BASE_URL https://prüf.koenigsblau.de
    SetEnv APP_BASE_PATH /

    # SSLEngine on
    # SSLCertificateFile /etc/letsencrypt/live/pruef.koenigsblau.de/fullchain.pem
    # SSLCertificateKeyFile /etc/letsencrypt/live/pruef.koenigsblau.de/privkey.pem
</VirtualHost>
